# Copy this file to .env and fill in real values. Never commit .env.

# Secret used to sign login tokens. Any long random string.
JWT_SECRET=change-me

# Key needed to call /api/admin/* routes (development only).
ADMIN_KEY=change-me

# Anthropic API key, used to search for events and tag them (Step 6).
# Get one at https://console.anthropic.com  ->  Settings  ->  API Keys  ->  Create Key
# Paste it straight after the = sign, with no quotes and no spaces.
ANTHROPIC_API_KEY=

# true = no live scraping and no live Claude calls (safe for the demo).
# Set to false only when you want to refresh events from the internet.
DEMO_MODE=true

# --- Event search (Step 6) ---
# How far ahead to look for events, in days ("a month" = 30).
EVENT_WINDOW_DAYS=30

# Which search STRATEGY to use (what to search for and how to judge results).
# Options are listed in docs/EVENT_SEARCH_LOGIC.md. category_sweep is the default.
EVENT_FINDER=category_sweep

# Which search ENGINE runs the queries. anthropic_web_search needs ANTHROPIC_API_KEY.
EVENT_SEARCH_PROVIDER=anthropic_web_search

# Which Claude model runs the web searches (a cheaper choice is claude-sonnet-5-5).
EVENT_SEARCH_MODEL=claude-opus-5-5

# Named in the User-Agent when the scraper visits other websites, so site owners can reach you.
# An email or a web page. Leave empty to send no contact (live scraping then refuses to start).
SCRAPER_CONTACT=

# true = only @ucl.ac.uk emails can register. Set to false for the demo (students cannot make UCL addresses).
REQUIRE_UCL_EMAIL=true
